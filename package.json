{
  "name": "aniwalls",
  "version": "1.0.0",
  "description": "AniWalls - Anime Wallpaper Telegram Bot & Mini App on Cloudflare Workers and D1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "npm run build:client",
    "build:client": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply aniwalls-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply aniwalls-db --remote"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hono": "^4.7.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.6",
    "wrangler": "^4.165.0"
  }
}
