# AniWalls Telegram Bot & Mini App Configuration
# Copy this file to .dev.vars for local development with `wrangler dev`

# Telegram Bot Token from @BotFather (Required for Bot & Mini App Auth)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Telegram Webhook Secret Token (Required for webhook security)
# Random string 1-256 characters (a-z, A-Z, 0-9, _, -)
TELEGRAM_WEBHOOK_SECRET="your_custom_secure_webhook_secret_here"

# Wallhaven API Key (Optional - allows searching SFW collections or higher rate limit)
WALLHAVEN_API_KEY=""

# SauceNAO API Key (Optional - for reverse image search)
SAUCENAO_API_KEY=""

# Environment mode: development or production
ENVIRONMENT="development"

# App Public URL (e.g., https://aniwalls.your-subdomain.workers.dev)
APP_BASE_URL="https://aniwalls.example.workers.dev"
